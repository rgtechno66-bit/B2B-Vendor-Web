# --- Site (see src/config-global.js CONFIG.site) ---
# API base. VITE_SERVER_URL wins over VITE_API_URL.
VITE_SERVER_URL=https://api.intecomart.com
VITE_API_URL=https://api.intecomart.com

# Dev only: "true" = call the URLs above from the browser. Omit/false = use /api (Vite proxy → localhost:3000).
# VITE_DEV_USE_LIVE_API=true

# Optional: CDN or separate asset host (empty = same origin)
VITE_ASSET_URL=

# Optional: app base path for subfolder deploys e.g. /vendor/
VITE_BASE_PATH=
